{
  "manifest_version": 3,
  "name": "octoview",
  "version": "0.1.0",
  "description": "Preview HTML, Gaussian splats, and notebooks straight from private GitHub repos.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://github.com/*", "https://raw.githubusercontent.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.js", "renderers/*", "vendor/*"],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
