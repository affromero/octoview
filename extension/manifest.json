{
  "manifest_version": 3,
  "name": "octoview",
  "version": "0.1.0",
  "description": "Preview HTML, Gaussian splats, and notebooks straight from private GitHub repos.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["vendor/marked.min.js", "core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://github.com/*", "https://raw.githubusercontent.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["vendor/splattie-widget.cdn.js"],
      "matches": ["https://github.com/*"]
    }
  ]
}
