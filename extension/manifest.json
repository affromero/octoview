{
  "manifest_version": 3,
  "name": "octoview",
  "version": "0.1.0",
  "description": "Preview HTML reports, Jupyter notebooks, 3D meshes and point clouds inline on private GitHub repos.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["vendor/marked.min.js", "core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://github.com/*", "https://raw.githubusercontent.com/*"],
  "web_accessible_resources": [
    {
      "resources": [
        "render3d.js",
        "render-array.js",
        "render-table.js",
        "vendor/three3d.esm.js",
        "vendor/hyparquet.esm.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  }
}
