{
  "manifest_version": 3,
  "name": "octoview",
  "version": "0.1.0",
  "description": "Preview HTML reports, notebooks, 3D/splats, arrays, tables, models and HDR images inline on private GitHub repos.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["vendor/marked.min.js", "vendor/highlight.min.js", "core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://github.com/*", "https://raw.githubusercontent.com/*"],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "splat-viewer.html",
        "splat-viewer.js",
        "splat-boot.js",
        "splattie-viewer.html",
        "splattie-viewer.js",
        "render3d.js",
        "render-array.js",
        "render-table.js",
        "render-model.js",
        "render-onnx.js",
        "render-image.js",
        "render-splat.js",
        "lcc-decode.js",
        "splat-decode.js",
        "unzip.js",
        "vendor/three3d.esm.js",
        "vendor/spark.esm.js",
        "vendor/splattie-widget.esm.js",
        "vendor/plotly.esm.js",
        "vendor/hyparquet.esm.js",
        "vendor/flechette.esm.js",
        "vendor/fflate.esm.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'"
  }
}
