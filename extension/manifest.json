{
  "manifest_version": 3,
  "name": "octoview",
  "version": "0.1.0",
  "description": "Preview 3D splats, notebooks, HTML reports, arrays, tables and models inline on GitHub, private repos included.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["vendor/marked.min.js", "vendor/highlight.min.js", "core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://media.githubusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "splat-viewer.html",
        "splat-viewer.js",
        "splat-boot.js",
        "splattie-viewer.html",
        "splattie-viewer.js",
        "render3d.js",
        "render-array.js",
        "render-table.js",
        "render-model.js",
        "render-onnx.js",
        "render-image.js",
        "render-splat.js",
        "splat-decode.js",
        "unzip.js",
        "vendor/three3d.esm.js",
        "vendor/spark.esm.js",
        "vendor/splattie-widget.esm.js",
        "vendor/plotly.esm.js",
        "vendor/hyparquet.esm.js",
        "vendor/flechette.esm.js",
        "vendor/fflate.esm.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'none'; object-src 'none'"
  }
}
