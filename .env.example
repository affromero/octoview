# Credentials for `npm run release:chrome` / `npm run release:firefox`.
# Copy to .env (gitignored) and fill in, OR export these however you manage
# secrets (direnv, `doppler run -- npm run release:chrome`, CI secrets, ...).
#
# These automate publishing a NEW VERSION of an extension that ALREADY EXISTS
# in each store. The first submission (listing copy, screenshots, privacy tab,
# email verification) is one-time and manual — do it in the dashboards first.
# Bump the version in extension/manifest.json before releasing; a store rejects
# a re-upload of a version it already has.

# --- Chrome Web Store (chrome-webstore-upload-cli) ---
# EXTENSION_ID: from the item's dashboard URL after the first manual submission.
# CLIENT_ID / CLIENT_SECRET / REFRESH_TOKEN: a Google Cloud OAuth client with the
# Chrome Web Store API enabled — see github.com/fregante/chrome-webstore-upload-keys
EXTENSION_ID=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# --- Firefox AMO (web-ext) ---
# Generate at addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
