# Binary preview fixtures and screenshots live in Git LFS — they are large,
# opaque, and never diffed, so keeping them out of the packed git objects keeps
# clones lean. Text/code stays in normal git.
samples/**/*.splat   filter=lfs diff=lfs merge=lfs -text
samples/**/*.spz     filter=lfs diff=lfs merge=lfs -text
samples/**/*.sog     filter=lfs diff=lfs merge=lfs -text
samples/**/*.ksplat  filter=lfs diff=lfs merge=lfs -text
samples/**/*.ply     filter=lfs diff=lfs merge=lfs -text
samples/**/*.splattie filter=lfs diff=lfs merge=lfs -text
samples/**/*.rad     filter=lfs diff=lfs merge=lfs -text
samples/**/*.bin     filter=lfs diff=lfs merge=lfs -text
samples/**/*.npy     filter=lfs diff=lfs merge=lfs -text
samples/**/*.npz     filter=lfs diff=lfs merge=lfs -text
samples/**/*.parquet filter=lfs diff=lfs merge=lfs -text
samples/**/*.arrow   filter=lfs diff=lfs merge=lfs -text
samples/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
samples/**/*.gguf    filter=lfs diff=lfs merge=lfs -text
samples/**/*.onnx    filter=lfs diff=lfs merge=lfs -text
